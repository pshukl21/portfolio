      "id": "layerremix",
      "sequence": true,
      "compact": true,
      "groups": [
        {
          "title": "Upload your unfinished PSD",
          "note": "The real preview comes straight from the file's own embedded thumbnail — no separate image upload, so it can never be misleading.",
