{
  "content": [
    {
      "id": "layerremix",
      "sequence": true,
      "compact": true,
      "groups": [
        {
          "title": "Where scrapped PSDs become finished art",
          "note": "Landing page. Upload unfinished PSDs, download the actual working file, remix and publish your version.",
          "images": [
            "/assets/layerremix/01.png"
          ]
        },
        {
          "title": "Upload your unfinished PSD",
          "note": "The real preview comes straight from the file's own embedded thumbnail — no separate image upload, so it can never be misleading.",
          "images": [
            "/assets/layerremix/02.png"
          ]
        },
        {
          "title": "Download someone else's real PSD",
          "note": "Every download is the actual layered source file, not a flattened preview.",
          "images": [
            "/assets/layerremix/03.png"
          ]
        },
        {
          "title": "Fix what needs work, then publish it",
          "note": "Describe exactly what changed, and the remix joins the original's lineage — credited, versioned, forkable.",
          "images": [
            "/assets/layerremix/04.png"
          ]
        },
        {
          "title": "Watch the whole history unfold",
          "note": "Every fork is versioned and connected back to the original: a visual lineage of who built what, and when.",
          "images": [
            "/assets/layerremix/05.png"
          ]
        }
      ]
    },
